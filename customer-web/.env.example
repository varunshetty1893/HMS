# Customer Web Environment Variables Template
# Public HTTPS URL of the deployed FastAPI backend (with or without /api/v1 - app normalizes automatically)
VITE_API_BASE_URL=https://your-hms-api.onrender.com/api/v1

# Public WSS URL of the deployed FastAPI WebSocket endpoint
# If left empty, customer-web automatically derives wss://your-hms-api.onrender.com/api/v1/ws from VITE_API_BASE_URL
VITE_WS_URL=wss://your-hms-api.onrender.com/api/v1/ws

VITE_APP_ENV=production
