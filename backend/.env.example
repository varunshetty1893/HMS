# =============================================================================
# Restaurant Management & QR Ordering System — Backend Environment Template
# =============================================================================
# Copy this file to `backend/.env` for local development.
# NEVER commit a real `.env` file or production secrets to Git.
# Generate 256-bit production secrets using:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# =============================================================================

# --- Application & Runtime ---
APP_NAME="Restaurant Management & QR Ordering API"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=false
API_V1_PREFIX="/api/v1"
HOST="127.0.0.1"
PORT=8000
LOG_LEVEL="INFO"

# --- PostgreSQL Database (Async SQLAlchemy + asyncpg) ---
DATABASE_URL="postgresql+asyncpg://restaurant_app:CHANGE_ME_LOCAL_DEV_PASSWORD@127.0.0.1:5432/restaurant_dev"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=5.0
DB_ECHO_SQL=false

# --- Security & Cryptographic Secrets ---
JWT_SECRET_KEY="CHANGE_ME_GENERATE_WITH_PYTHON_SECRETS_TOKEN_HEX_32_MINIMUM_64_HEX"
CSRF_SECRET_KEY="CHANGE_ME_GENERATE_WITH_PYTHON_SECRETS_TOKEN_HEX_32_CSRF_SECRET_KEY"
QR_TOKEN_ENCRYPTION_KEY="CHANGE_ME_GENERATE_WITH_PYTHON_SECRETS_TOKEN_HEX_32_QR_PRINT_KEY"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS & Public URLs ---
CORS_ALLOWED_ORIGINS='["http://localhost:5173","http://localhost:5174","http://localhost:3000","http://localhost:3001"]'
PUBLIC_QR_BASE_URL="http://localhost:3001/q"

# --- Realtime WebSockets ---
WS_MAX_CONNECTIONS=200
WS_HEARTBEAT_INTERVAL_SECONDS=30

# --- Local Dish Image Storage (Zero-Cost Local Filesystem) ---
UPLOAD_DIR="./uploads/menu"
MAX_UPLOAD_SIZE_BYTES=2097152
