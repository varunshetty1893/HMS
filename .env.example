# =============================================================================
# Restaurant Management System (HMS) — Root Environment Configuration
# =============================================================================

# --- Backend Application Mode ---
# Choices: 'development' | 'test' | 'production'
ENVIRONMENT=development
DEBUG=true
APP_NAME="Restaurant Management & QR Ordering System"
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- Database Connection ---
# Local SQLite for testing: sqlite+aiosqlite:///./hms_test.db
# PostgreSQL (Production & Local Docker): postgresql+asyncpg://postgres:postgres@localhost:5432/hms_dev
DATABASE_URL=sqlite+aiosqlite:///./hms_dev.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10.0
DB_ECHO_SQL=false

# --- Cryptographic Secrets ---
# In production, must be at least 32 characters generated via `openssl rand -hex 32`
JWT_SECRET_KEY=dev_jwt_secret_key_change_in_production_min_32_chars
CSRF_SECRET_KEY=dev_csrf_secret_key_change_in_production_min_32_chars
QR_TOKEN_ENCRYPTION_KEY=dev_qr_encryption_key_change_in_production_32ch
# AUDIT_IP_HASH_SECRET: used for daily-keyed HMAC-SHA256 IP pseudonymisation in audit logs.
# Falls back to JWT_SECRET_KEY if not set.  Set a unique value in production.
AUDIT_IP_HASH_SECRET=dev_audit_ip_hash_secret_change_in_production_32ch
# ADMIN_RECOVERY_KEY: optional break-glass key (16+ chars) so a locked-out admin can use
# "Forgot password?" on the admin login page. Leave empty to disable. `openssl rand -hex 16`
ADMIN_RECOVERY_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Routing, CORS & Physical QR ---
# Comma-separated allowed web origins (no wildcards in production)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174
PUBLIC_QR_BASE_URL=http://localhost:3000/q
API_V1_PREFIX=/api/v1

# --- Reverse proxy / real client IP (rate limiting, audit) ---
# Default (both empty/0): X-Forwarded-For / X-Real-IP are IGNORED (safe, cannot be spoofed).
#
# TRUSTED_PROXY_IPS: comma-separated exact IPs or CIDR ranges of proxies whose peer address
#   is STABLE (Caddy container on the Docker bridge, e.g. 172.16.0.0/12). Only requests whose
#   TCP peer matches may set X-Real-IP / X-Forwarded-For. Leave empty in local dev.
TRUSTED_PROXY_IPS=
# PROXY_HOPS: for hosts whose proxy IPs are NOT stable (Render). Number of trusted proxies in
#   front of the app; X-Forwarded-For is read from the RIGHT, so client-prepended values cannot
#   spoof the IP. 0 = off. Calibrate on Render with GET /api/v1/admin/diagnostics/client-ip
#   (admin token) and set to the hop count where "resolved_client_ip" is YOUR real public IP.
#   Never set this when the app is directly reachable from the internet without a proxy.
PROXY_HOPS=0

# --- Real-Time WebSockets ---
WS_MAX_CONNECTIONS=200
# Staff/customer tokens are sent as the FIRST WebSocket frame ({"type":"auth",...}), not in the URL.
# Legacy ?token= / ?customer_token= query auth stays on during rollout; set to false once the
# web + Flutter clients are updated (deploy backend first, then clients, then flip this).
WS_ALLOW_QUERY_TOKEN=true
WS_AUTH_TIMEOUT_SECONDS=5
WS_HEARTBEAT_INTERVAL_SECONDS=30

# --- Media Storage (local fallback when ImageKit is not configured) ---
UPLOAD_DIR=./uploads/menu
MAX_UPLOAD_SIZE_BYTES=2097152
# Max HTTP body bytes for image upload endpoint (3 MB to allow multipart framing overhead)
IMAGE_UPLOAD_MAX_BODY_BYTES=3145728

# --- ImageKit CDN (optional — free plan: 3 GB storage, 20 GB/month bandwidth) ---
# Leave IMAGEKIT_PRIVATE_KEY blank to use local filesystem storage instead.
# imagekitio v5 SDK only requires the private key.
# Get your private key from: https://imagekit.io → Dashboard → Developer Options
#
# IMAGEKIT_PRIVATE_KEY  : Your ImageKit private API key — NEVER expose in frontend!
# IMAGEKIT_UPLOAD_FOLDER: Folder inside your ImageKit media library (default: /menu)
#
# Required on Render: add these as Environment Variables in the Render dashboard.
# Do NOT commit real values to git.
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_UPLOAD_FOLDER=/menu

# --- Web Frontend Environment Variables ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/api/v1/ws
VITE_APP_ENV=development