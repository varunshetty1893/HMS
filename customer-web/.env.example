# ─────────────────────────────────────────────────────────────────────────────
# Customer Web (Customer QR Ordering SPA) Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────

# --- Production Deployment (Vercel / Cloudflare Pages) ---
# Public HTTPS URL of your deployed FastAPI backend.
# The application automatically normalizes trailing slashes and ensures /api/v1 suffix.
VITE_API_BASE_URL=https://<your-render-app>.onrender.com/api/v1

# Public WSS URL of the deployed FastAPI WebSocket endpoint.
# If omitted, Customer Web automatically derives wss://<backend-domain>/api/v1/ws from VITE_API_BASE_URL.
VITE_WS_URL=wss://<your-render-app>.onrender.com/api/v1/ws

# Environment name: 'production' | 'development' | 'test'
VITE_APP_ENV=production

# --- Local Development Flags (Ignored in Production Builds) ---
# Set to 'true' in development to test real restaurant QR-only behavior with demo buttons hidden:
# VITE_DISABLE_DEV_DEMO=false
