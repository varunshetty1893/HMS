{
    # Global Caddy configuration
    admin off
    servers {
        trusted_proxies static 127.0.0.1
    }
}

{$APP_DOMAIN:localhost} {
    # Automatic Let's Encrypt TLS in production
    encode zstd gzip

    # Production Security Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }

    # Dish Media Serving with sandboxed headers (no execution)
    handle /media/* {
        root * /var/lib/restaurant/uploads
        header Content-Security-Policy "default-src 'none'"
        header X-Content-Type-Options "nosniff"
        header Cache-Control "public, max-age=2592000"
        file_server
    }

    # Backend REST API and Realtime WebSocket Reverse Proxy
    handle /api/v1/* {
        @image_upload path /api/v1/admin/menu/items/*/image
        request_body @image_upload {
            max_size 2.5MB
        }
        request_body {
            max_size 64KB
        }

        reverse_proxy 127.0.0.1:8000 {
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-For {remote_host}
            transport http {
                read_timeout 90s
                write_timeout 90s
            }
        }
    }

    # Admin Web Dashboard SPA
    handle_path /admin* {
        root * /var/www/admin-web/dist
        try_files {path} /index.html
        header /assets/* Cache-Control "public, max-age=31536000, immutable"
        header /index.html Cache-Control "no-cache, no-store, must-revalidate"
        file_server
    }

    # Customer Web Ordering SPA
    handle {
        root * /var/www/customer-web/dist
        try_files {path} /index.html
        header /assets/* Cache-Control "public, max-age=31536000, immutable"
        header /index.html Cache-Control "no-cache, no-store, must-revalidate"
        file_server
    }
}
