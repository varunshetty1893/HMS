# =============================================================================
# FastAPI Backend Environment Variables (Production & Staging Template)
# =============================================================================

# --- Core Service ---
ENVIRONMENT=production
DEBUG=false
APP_NAME="Restaurant Management & QR Ordering API"
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- Database (Render, Neon, Supabase, or Railway PostgreSQL) ---
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
# Note: Render/Neon provide postgres:// URLs which the app automatically normalizes to postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://user:password@host.provider.net:5432/hms_prod
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10.0
DB_ECHO_SQL=false

# --- Authentication & Secrets (Generate with `openssl rand -hex 32`) ---
# MUST be at least 32 characters in production, with no dev placeholders!
JWT_SECRET_KEY=replace_with_openssl_rand_hex_32_output_here
CSRF_SECRET_KEY=replace_with_openssl_rand_hex_32_output_here
# Optional encryption key for high-security tamper-proof table QR tokens
QR_TOKEN_ENCRYPTION_KEY=replace_with_openssl_rand_hex_32_output_here
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Explicit comma-separated or JSON list of allowed frontend origins (NO WILDCARDS in production)
CORS_ALLOWED_ORIGINS=https://spicehub.pages.dev,https://spicehub-admin.pages.dev
# Base URL encoded inside physical table QR stickers pointing to deployed customer web app
PUBLIC_QR_BASE_URL=https://spicehub.pages.dev/q

# --- Realtime WebSockets ---
WS_MAX_CONNECTIONS=500
WS_HEARTBEAT_INTERVAL_SECONDS=30

# --- File Storage (Ephemeral in Render Free; consider cloud object store if permanent dish photos required) ---
UPLOAD_DIR=./uploads/menu
MAX_UPLOAD_SIZE_BYTES=2097152

# --- Browser refresh-token cookie (used only when the admin web is built with VITE_AUTH_COOKIE=true) ---
# lax/strict when the web app and API share a site (e.g. Vercel rewrite of /api/*).
# none is for a cross-site deployment only; Safari/Firefox block such cookies by default.
AUTH_COOKIE_NAME=hms_refresh
AUTH_COOKIE_SAMESITE=lax
# Optional. Unset = Secure in production, not Secure on http://localhost.
# AUTH_COOKIE_SECURE=true
