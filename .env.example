# =============================================================================
# Restaurant Management System (HMS) — Root Environment Configuration
# =============================================================================

# --- Backend Application Mode ---
# Choices: 'development' | 'test' | 'production'
ENVIRONMENT=development
DEBUG=true
APP_NAME="Restaurant Management & QR Ordering System"
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- Database Connection ---
# Local SQLite for testing: sqlite+aiosqlite:///./hms_test.db
# PostgreSQL (Production & Local Docker): postgresql+asyncpg://postgres:postgres@localhost:5432/hms_dev
DATABASE_URL=sqlite+aiosqlite:///./hms_dev.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10.0
DB_ECHO_SQL=false

# --- Cryptographic Secrets ---
# In production, must be at least 32 characters generated via `openssl rand -hex 32`
JWT_SECRET_KEY=dev_jwt_secret_key_change_in_production_min_32_chars
CSRF_SECRET_KEY=dev_csrf_secret_key_change_in_production_min_32_chars
QR_TOKEN_ENCRYPTION_KEY=dev_qr_encryption_key_change_in_production_32ch
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Routing, CORS & Physical QR ---
# Comma-separated allowed web origins (no wildcards in production)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174
PUBLIC_QR_BASE_URL=http://localhost:3000/q
API_V1_PREFIX=/api/v1

# --- Real-Time WebSockets ---
WS_MAX_CONNECTIONS=200
WS_HEARTBEAT_INTERVAL_SECONDS=30

# --- Media Storage ---
UPLOAD_DIR=./uploads/menu
MAX_UPLOAD_SIZE_BYTES=2097152

# --- Web Frontend Environment Variables ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/api/v1/ws
VITE_APP_ENV=development