# ─────────────────────────────────────────────────────────────────────────────
# Admin Web (Management & Billing Control Panel) Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────

# --- Production Deployment (Vercel / Cloudflare Pages) ---
# Public HTTPS URL of your deployed FastAPI backend.
# In production, mock routing and demo pre-filled logins are strictly forbidden.
VITE_API_BASE_URL=https://your-hms-api.onrender.com/api/v1

# Public WSS URL of the deployed FastAPI WebSocket endpoint.
# If omitted, Admin Web automatically derives wss://<backend-domain>/api/v1/ws from VITE_API_BASE_URL.
VITE_WS_URL=wss://your-hms-api.onrender.com/api/v1/ws

# Environment mode: 'production' | 'development' | 'test'
VITE_APP_ENV=production

# --- Local Development Flags (Strictly Forbidden in Production Builds) ---
# Opt-in to client-side in-memory mock routing in local dev when backend is not running.
# In production builds, this flag is completely ignored and mock routing is inert.
# VITE_ENABLE_DEV_MOCKS=false

# Set to 'true' in development to hide the staff credentials helper card:
# VITE_DISABLE_DEV_DEMO=false
