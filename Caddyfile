{
    # Global Caddy configuration
    admin off
    servers {
        # Trust the backend container's peer IP on the Docker internal_net bridge.
        # In Docker Compose the Caddy container connects to the backend container
        # via the 'internal_net' bridge network. Caddy itself is the trusted proxy;
        # listing its own loopback here ensures header_up rewrites are accepted.
        # For a bare-metal / Render deployment without Docker, set this to the
        # actual upstream proxy IP or leave as 127.0.0.1.
        trusted_proxies static 127.0.0.1 172.16.0.0/12 10.0.0.0/8
    }
}

{$APP_DOMAIN:localhost} {
    # Automatic Let's Encrypt TLS in production
    encode zstd gzip

    # Production Security Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }

    # Dish Media Serving with sandboxed headers (no execution)
    # Served from the shared media_uploads Docker volume.
    # URL path: /media/*  (consistent with image_url stored in PostgreSQL)
    handle /media/* {
        root * /var/lib/restaurant/uploads
        uri strip_prefix /media
        header Content-Security-Policy "default-src 'none'"
        header X-Content-Type-Options "nosniff"
        header Cache-Control "public, max-age=2592000"
        file_server
    }

    # Backend REST API and Realtime WebSocket Reverse Proxy
    handle /api/v1/* {
        # Allow larger bodies specifically for the image-upload endpoint.
        @image_upload {
            method POST
            path /api/v1/admin/menu/items/*/image
        }
        request_body @image_upload {
            max_size 3MB
        }
        # All other API requests are limited to 64 KB.
        request_body {
            max_size 64KB
        }

        # Route to the 'backend' Docker service (not 127.0.0.1 which is Caddy itself).
        reverse_proxy backend:8000 {
            # Overwrite / sanitize client-supplied forwarding headers so FastAPI
            # can safely trust X-Forwarded-For as a single verified entry.
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Real-IP {remote_host}
            transport http {
                read_timeout 90s
                write_timeout 90s
            }
        }
    }

    # Admin Web Dashboard SPA
    handle_path /admin* {
        root * /var/www/admin-web/dist
        try_files {path} /index.html
        header /assets/* Cache-Control "public, max-age=31536000, immutable"
        header /index.html Cache-Control "no-cache, no-store, must-revalidate"
        file_server
    }

    # Customer Web Ordering SPA
    handle {
        root * /var/www/customer-web/dist
        try_files {path} /index.html
        header /assets/* Cache-Control "public, max-age=31536000, immutable"
        header /index.html Cache-Control "no-cache, no-store, must-revalidate"
        file_server
    }
}
